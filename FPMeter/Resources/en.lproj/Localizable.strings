// Glossary
"glossary.title" = "FP Glossary";
"glossary.intro" = "A practical guide to the IFPUG Function Point Analysis terms used in this app.";
"glossary.quickReference" = "Quick Reference";
"glossary.whenToUse" = "When to use";
"glossary.parameters" = "Complexity parameters";
"glossary.example" = "Example";
"glossary.terms.ILF.desc" = "An Internal Logical File (ILF) represents a user-recognizable group of logically related data maintained within the boundary of the application.";
"glossary.terms.ILF.whenToUse" = "Any table or data store that your app creates, reads, updates, or deletes.";
"glossary.terms.ILF.example" = "User account data stored in your app's own database.";
"glossary.terms.EIF.desc" = "An External Interface File (EIF) is a group of logically related data referenced by the application, but maintained by another application.";
"glossary.terms.EIF.whenToUse" = "Data you read from another system but don't own.";
"glossary.terms.EIF.example" = "Product catalog data fetched from a 3rd-party supplier API.";
"glossary.terms.EI.desc" = "An External Input (EI) processes data or control information that crosses the boundary from outside to inside the application.";
"glossary.terms.EI.whenToUse" = "Any form submission, API call received, or bulk import.";
"glossary.terms.EI.example" = "A login form submitted by the user.";
"glossary.terms.EO.desc" = "An External Output (EO) sends data or control information out of the application boundary, including derived data (calculations, totals).";
"glossary.terms.EO.whenToUse" = "Reports, exports, or dashboards that perform calculations or aggregation.";
"glossary.terms.EO.example" = "A monthly sales report generated and downloaded as a PDF.";
"glossary.terms.EQ.desc" = "An External Inquiry (EQ) is a retrieval of data — input + output pair — that does not maintain any ILF and does not contain derived data.";
"glossary.terms.EQ.whenToUse" = "Simple queries and searches that just return existing data.";
"glossary.terms.EQ.example" = "A search box that returns filtered product results.";
"glossary.terms.DET.desc" = "A Data Element Type (DET) is a unique user-recognizable, non-repeated field.";
"glossary.terms.DET.example" = "Each field in a form (email, password, name = 3 DETs).";
"glossary.terms.RET.desc" = "A Record Element Type (RET) is a user-recognizable subgroup of data elements within an ILF or EIF.";
"glossary.terms.RET.example" = "A user profile with sub-sections: basic info + address = 2 RETs.";
"glossary.terms.FTR.desc" = "A File Type Referenced (FTR) is an ILF or EIF read or maintained by a transactional function (EI/EO/EQ).";
"glossary.terms.FTR.example" = "A login EI reads from the Users table and the Roles table = 2 FTRs.";
"glossary.terms.UFP.desc" = "Unadjusted Function Points — the sum of complexity-weighted function points before applying technical adjustments.";
"glossary.terms.UFP.example" = "5 Low EIs × 3 UFP = 15 UFP.";
"glossary.terms.AFP.desc" = "Adjusted Function Points — UFP multiplied by the Value Adjustment Factor (VAF).";
"glossary.terms.AFP.example" = "AFP = UFP × VAF.";
"glossary.terms.VAF.desc" = "Value Adjustment Factor — a multiplier from 0.65 to 1.35 derived from 14 General System Characteristics.";
"glossary.terms.VAF.example" = "VAF = 0.65 + (0.01 × sum of 14 GSC ratings).";
"glossary.terms.GSC.desc" = "General System Characteristics — 14 factors rated 0–5 that describe the technical and operational context of the system.";
"glossary.terms.GSC.example" = "Performance, transaction rate, reusability, multiple sites, etc.";
"glossary.terms.MM.desc" = "Man-Month (or Person-Month) — a unit of effort equal to one person working for one month. Calculated as AFP ÷ productivity factor.";
"glossary.terms.MM.example" = "60 AFP ÷ 8 FP/PM = 7.5 person-months.";


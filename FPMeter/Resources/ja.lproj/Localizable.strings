// Glossary
"glossary.title" = "FP 用語集";
"glossary.intro" = "このアプリで使用する IFPUG ファンクションポイント分析用語の実践ガイド。";
"glossary.quickReference" = "クイックリファレンス";
"glossary.whenToUse" = "使いどころ";
"glossary.parameters" = "複雑度パラメータ";
"glossary.example" = "例";
"glossary.terms.ILF.desc" = "内部論理ファイル (ILF) は、アプリケーション境界内で管理される、ユーザーが認識可能な論理的に関連したデータのグループです。";
"glossary.terms.ILF.whenToUse" = "アプリが作成・参照・更新・削除するテーブルやデータストア。";
"glossary.terms.ILF.example" = "アプリのデータベースに保存されるユーザーアカウントデータ。";
"glossary.terms.EIF.desc" = "外部インターフェイスファイル (EIF) は、他のアプリケーションが管理し、本アプリが参照するデータのグループです。";
"glossary.terms.EIF.whenToUse" = "他システムから読み込むが保有しないデータ。";
"glossary.terms.EIF.example" = "サードパーティ API から取得する商品カタログ。";
"glossary.terms.EI.desc" = "外部入力 (EI) は、アプリケーション境界の外から内へ入ってくるデータ・制御情報を処理します。";
"glossary.terms.EI.whenToUse" = "フォーム送信、受信 API、一括インポートなど。";
"glossary.terms.EI.example" = "ユーザーが送信するログインフォーム。";
"glossary.terms.EO.desc" = "外部出力 (EO) は、計算や集計などの派生データを含め、アプリケーション境界の外へ送出するデータ・制御情報です。";
"glossary.terms.EO.whenToUse" = "計算・集計を行うレポート、エクスポート、ダッシュボード。";
"glossary.terms.EO.example" = "PDF として生成・ダウンロードされる月次売上レポート。";
"glossary.terms.EQ.desc" = "外部照会 (EQ) は、ILF を維持せず派生データを含まない、入出力対のデータ取得です。";
"glossary.terms.EQ.whenToUse" = "既存データのみ返す単純な問い合わせ・検索。";
"glossary.terms.EQ.example" = "絞り込んだ商品結果を返す検索ボックス。";
"glossary.terms.DET.desc" = "データ要素タイプ (DET) は、ユーザーが認識可能で一意、かつ重複しないフィールドです。";
"glossary.terms.DET.example" = "フォームの各フィールド (メール・パスワード・氏名 = 3 DET)。";
"glossary.terms.RET.desc" = "レコード要素タイプ (RET) は、ILF/EIF 内でユーザーが認識可能なデータ要素のサブグループです。";
"glossary.terms.RET.example" = "サブセクション付きユーザープロフィール: 基本情報 + 住所 = 2 RET。";
"glossary.terms.FTR.desc" = "参照ファイルタイプ (FTR) は、トランザクション機能 (EI/EO/EQ) が読み書きする ILF または EIF です。";
"glossary.terms.FTR.example" = "ログイン EI が Users と Roles テーブルを読む = 2 FTR。";
"glossary.terms.UFP.desc" = "未調整ファンクションポイント — 技術的調整を行う前の、複雑度重み付けされた FP の合計。";
"glossary.terms.UFP.example" = "Low EI 5 件 × 3 UFP = 15 UFP。";
"glossary.terms.AFP.desc" = "調整済みファンクションポイント — UFP に価値調整係数 (VAF) を乗じた値。";
"glossary.terms.AFP.example" = "AFP = UFP × VAF。";
"glossary.terms.VAF.desc" = "価値調整係数 — 14の一般システム特性から導出される 0.65〜1.35 の乗数。";
"glossary.terms.VAF.example" = "VAF = 0.65 + (0.01 × 14 GSC の合計)。";
"glossary.terms.GSC.desc" = "一般システム特性 — システムの技術的・運用的文脈を表す 14 の要素、各 0–5 点。";
"glossary.terms.GSC.example" = "性能、トランザクション率、再利用性、複数拠点など。";
"glossary.terms.MM.desc" = "人月 — 1 人が 1 か月作業する工数単位。AFP ÷ 生産性係数 で算出。";
"glossary.terms.MM.example" = "60 AFP ÷ 8 FP/人月 = 7.5 人月。";


// Glossary
"glossary.title" = "FP 용어집";
"glossary.intro" = "이 앱에서 사용하는 IFPUG 기능 점수 분석 용어의 실무 가이드입니다.";
"glossary.quickReference" = "요약 참조";
"glossary.whenToUse" = "사용 시점";
"glossary.parameters" = "복잡도 매개변수";
"glossary.example" = "예시";
"glossary.terms.ILF.desc" = "내부 논리 파일(ILF)은 애플리케이션 경계 내에서 유지되는, 사용자가 인식 가능한 논리적으로 관련된 데이터 그룹입니다.";
"glossary.terms.ILF.whenToUse" = "앱이 생성, 조회, 수정, 삭제하는 테이블이나 데이터 저장소.";
"glossary.terms.ILF.example" = "앱의 데이터베이스에 저장된 사용자 계정 데이터.";
"glossary.terms.EIF.desc" = "외부 인터페이스 파일(EIF)은 다른 애플리케이션이 관리하지만 이 앱이 참조하는 데이터 그룹입니다.";
"glossary.terms.EIF.whenToUse" = "다른 시스템에서 읽어오지만 소유하지 않는 데이터.";
"glossary.terms.EIF.example" = "외부 공급사 API에서 가져오는 상품 카탈로그.";
"glossary.terms.EI.desc" = "외부 입력(EI)은 애플리케이션 경계 밖에서 안으로 들어오는 데이터·제어 정보를 처리합니다.";
"glossary.terms.EI.whenToUse" = "폼 제출, 수신 API 호출, 일괄 가져오기.";
"glossary.terms.EI.example" = "사용자가 제출한 로그인 폼.";
"glossary.terms.EO.desc" = "외부 출력(EO)은 계산·집계 등 파생 데이터를 포함하여 애플리케이션 경계 밖으로 내보내는 데이터·제어 정보입니다.";
"glossary.terms.EO.whenToUse" = "계산이나 집계를 수행하는 보고서, 내보내기, 대시보드.";
"glossary.terms.EO.example" = "PDF로 생성·다운로드되는 월간 매출 보고서.";
"glossary.terms.EQ.desc" = "외부 조회(EQ)는 ILF를 유지하지 않고 파생 데이터가 없는, 입력-출력 쌍의 데이터 조회입니다.";
"glossary.terms.EQ.whenToUse" = "기존 데이터만 반환하는 단순 질의나 검색.";
"glossary.terms.EQ.example" = "필터링된 상품 결과를 반환하는 검색 창.";
"glossary.terms.DET.desc" = "데이터 요소 유형(DET)은 사용자가 인식할 수 있는 고유하고 반복되지 않는 필드입니다.";
"glossary.terms.DET.example" = "폼의 각 필드(이메일, 비밀번호, 이름 = 3 DET).";
"glossary.terms.RET.desc" = "레코드 요소 유형(RET)은 ILF/EIF 내에서 사용자가 인식 가능한 데이터 요소의 하위 그룹입니다.";
"glossary.terms.RET.example" = "하위 섹션이 있는 사용자 프로필: 기본정보 + 주소 = 2 RET.";
"glossary.terms.FTR.desc" = "참조 파일 유형(FTR)은 트랜잭션 기능(EI/EO/EQ)이 읽거나 유지하는 ILF 또는 EIF입니다.";
"glossary.terms.FTR.example" = "로그인 EI가 Users와 Roles 테이블을 읽음 = 2 FTR.";
"glossary.terms.UFP.desc" = "조정 전 기능 점수 — 기술적 조정 전 복잡도 가중치가 적용된 기능 점수의 합.";
"glossary.terms.UFP.example" = "Low EI 5개 × 3 UFP = 15 UFP.";
"glossary.terms.AFP.desc" = "조정 후 기능 점수 — UFP에 가치 조정 인자(VAF)를 곱한 값.";
"glossary.terms.AFP.example" = "AFP = UFP × VAF.";
"glossary.terms.VAF.desc" = "가치 조정 인자 — 14개 일반 시스템 특성에서 도출되는 0.65~1.35의 승수.";
"glossary.terms.VAF.example" = "VAF = 0.65 + (0.01 × 14개 GSC 합계).";
"glossary.terms.GSC.desc" = "일반 시스템 특성 — 시스템의 기술적·운영적 맥락을 나타내는 14개 요인, 각 0–5점.";
"glossary.terms.GSC.example" = "성능, 트랜잭션율, 재사용성, 다중 사이트 등.";
"glossary.terms.MM.desc" = "맨먼스(인월) — 한 사람이 한 달 일하는 노력의 단위. AFP ÷ 생산성 인자로 계산.";
"glossary.terms.MM.example" = "60 AFP ÷ 8 FP/PM = 7.5 인월.";

